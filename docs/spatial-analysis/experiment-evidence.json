      "claims": [
        {
          "id": "c0001",
          "kind": "observed",
          "text": "Route seen: shelving-lined study, wide opening to sitting room, exit into long landing/hall, bathroom doorway on travel-left, bedroom doorway on travel-right, then dining room and adjoining kitchen. Bathroom includes sink and mirror, glass shower, toilet and window; bedroom is only viewed from threshold.",
